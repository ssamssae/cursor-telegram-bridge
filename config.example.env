# Copy to .env and edit locally. Do not commit .env.
#
# Only the first two settings are required. Everything below has a working
# default; change one only when the matching README section tells you to.

# The one Telegram chat id allowed to reach this machine. There is no default
# on purpose - the bridge refuses to start until you set your own.
CUB_CHAT_ID=123456789
CUB_TOKEN_FILE="$HOME/.config/cursor-telegram-bridge/token.json"

CUB_STATE_DIR="$HOME/.cursor-telegram-bridge/state"

# Path to the cursor-agent binary, if it is not on your PATH.
CUB_CURSOR_BIN=cursor-agent

# tmux session the TUI lane pastes into. Create it first (see README).
CUB_TMUX_SESSION=cursor

# Seconds to wait for one Cursor turn before giving up.
CUB_TUI_WAIT_SEC=900

# If Cursor is still running tools when CUB_TUI_WAIT_SEC passes, keep waiting
# up to this hard cap instead of re-running the prompt headless.
CUB_TUI_WAIT_MAX_SEC=7200

# While extended, give up if the transcript stops growing for this long.
CUB_TUI_BUSY_STALL_SEC=900

# Idle context guard: when nothing is running and Cursor's status line shows
# context usage at or above this percent, send /clear automatically. 0 = off.
CUB_CONTEXT_CLEAR_PCT=50
CUB_CONTEXT_CLEAR_COOLDOWN_SEC=600

# When the tmux session is gone, run one `cursor-agent -p` instead.
# On by default so a first install works before you learn tmux.
CUB_TUI_FALLBACK_HEADLESS=1

# Also send turns typed in the tmux session to Telegram. Off by default
# in the public build so a first install does not dump old terminal history.
CUB_TUI_MIRROR_LOCAL=0

# Run without calling Cursor at all - useful for checking your setup.
CUB_DRY_RUN=0

# Request optional useful follow-ups on ordinary Telegram prompts. 0 = off (default).
CUB_SUGGESTED_TAIL_PROMPT=0
# Render tagged suggestions as a Confirm button. 0 = off (default). Set 1 to enable.
CUB_SUGGESTED_REPLY_SPLIT=0
